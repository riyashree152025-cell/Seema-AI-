<?xml version="1.0" encoding="utf-8"?>
<!--
  No plain (unencrypted) HTTP anywhere: every AI, voice and web service is HTTPS.
  The only exception is Ollama running on this phone itself (localhost). An Ollama on a PC in the house needs
  that PC's fixed LAN address added below as its own <domain> (this file cannot take a range like 192.168.x.x).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
